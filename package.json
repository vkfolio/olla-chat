{
  "name": "olla-chat",
  "displayName": "Olla Chat",
  "description": "Professional AI Assistant for VS Code using Ollama",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [
    "onView:olla-chat.sidebar.view"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "olla-chat-sidebar",
          "title": "Olla Chat",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "olla-chat-sidebar": [
        {
          "type": "webview",
          "id": "olla-chat.sidebar.view",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "olla-chat.focus",
        "title": "Focus Olla Chat",
        "category": "Olla Chat"
      }
    ],
    "configuration": {
      "title": "Olla Chat Parameters",
      "properties": {
        "olla-chat.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "The URL to the Ollama instance."
        },
        "olla-chat.ollamaModel": {
          "type": "string",
          "default": "llama3",
          "description": "The model to use (requires tool calling support, like llama3 or qwen2.5)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "webpack": "webpack --mode development",
    "webpack-dev": "webpack --mode development --watch"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "^1.85.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@langchain/community": "^0.3.59",
    "@langchain/core": "^0.3.80",
    "@langchain/ollama": "0.2.0"
  }
}